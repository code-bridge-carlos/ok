{
  "manifest_version": 3,
  "name": "DeepSeek Gateway Extension",
  "version": "2.1",
  "description": "Ejecuta requests de DeepSeek dentro del browser para el gateway",
  "permissions": ["activeTab", "storage", "cookies"],
  "host_permissions": ["https://chat.deepseek.com/*", "https://deepseek.com/*", "https://carlos-gateway.onrender.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
